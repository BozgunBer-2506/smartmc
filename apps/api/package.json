{
  "name": "@smc/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter \"@smc/api^...\" run build",
    "build": "tsc -p tsconfig.json",
    "dev": "nodemon --watch src --watch ../../packages --ext ts,json --exec \"ts-node src/main.ts\"",
    "prestart": "pnpm --filter @smc/database db:migrate:deploy",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "verify:token-refresh-logic": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/verify-token-refresh-logic.ts",
    "verify:transactional-email-binding": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/verify-transactional-email-binding.ts",
    "verify:resend-adapter": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/verify-resend-adapter.ts",
    "verify:inbox-pagination-logic": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/verify-inbox-pagination-logic.ts",
    "verify:auth-security-config": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/verify-auth-security-config.ts",
    "verify:metrics-production-gating": "ts-node --transpile-only --project tsconfig.json -O '{\"module\":\"commonjs\"}' ../../scripts/verify-metrics-production-gating.ts",
    "verify:phase16.1-security-prework": "ts-node --transpile-only --project tsconfig.json -O '{\"module\":\"commonjs\"}' ../../scripts/verify-phase16.1-security-prework.ts",
    "verify:beta-invites": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/verify-beta-invites.ts",
    "beta:create-invite": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/create-beta-invite.ts",
    "verify:workspace-deletion": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/verify-workspace-deletion.ts",
    "verify:account-deletion": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/verify-account-deletion.ts",
    "verify:realtime-membership": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/verify-realtime-membership.ts",
    "verify:events-redis-retention": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/verify-events-redis-retention.ts",
    "verify:workspace-deletion-redis-timeout": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/verify-workspace-deletion-redis-timeout.ts",
    "db:backup": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/db-backup.ts",
    "db:restore": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/db-restore.ts",
    "verify:db-backup-restore": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' ../../scripts/verify-db-backup-restore.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/websockets": "^10.4.0",
    "@smc/ai": "workspace:*",
    "@smc/automation-engine": "workspace:*",
    "@smc/connector-sdk": "workspace:*",
    "@smc/database": "workspace:*",
    "@smc/event-model": "workspace:*",
    "@smc/identity": "workspace:*",
    "@smc/shared": "workspace:*",
    "argon2": "^0.41.0",
    "bullmq": "^5.28.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.0",
    "uuid": "^11.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@smc/config": "workspace:*",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "nodemon": "^3.1.0",
    "socket.io-client": "^4.8.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0"
  }
}
