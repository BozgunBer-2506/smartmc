PORT=4000
DATABASE_URL="postgresql://smc:smc_dev_password@localhost:5433/smc_dev"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Web Push VAPID keys (docs/ROADMAP.md Phase 14) - generate your own with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Transactional email (password reset). Leave TRANSACTIONAL_EMAIL_PROVIDER
# unset to keep the existing dev fake locally / a loud unconfigured-state
# error in production. Set to "resend" plus both variables below to send
# real email via Resend - all three variables are required together, or
# the app fails fast at startup. Reset links are built from
# WEB_APP_BASE_URL (see AUTH config), not a separate variable.
TRANSACTIONAL_EMAIL_PROVIDER=
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=

# Auth token signing. Required in production (the API refuses to start
# without it, or with the public development value). Use a long random
# value, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every user out.
JWT_SECRET=

# Credentialed CORS allowlist. WEB_APP_BASE_URL (the web app's URL, also
# used for password-reset links) is always allowed; CORS_ALLOWED_ORIGINS
# adds comma-separated extra origins. No wildcards. Production requires
# at least one https origin; locally http://localhost:3000 is the default.
WEB_APP_BASE_URL=
CORS_ALLOWED_ORIGINS=
