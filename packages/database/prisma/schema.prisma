// A growing subset of docs/DATABASE.md's full schema - implemented as
// later phases actually need more of it, not speculatively ahead of need.
// Phase 1 added the messaging core (Workspace/Provider/Contact/
// ContactIdentity/Conversation/Message/Notification). Phase 2 adds
// Organization, User, UserCredentials, WorkspaceMember, Session, and
// AuditLog for authentication (docs/ROADMAP.md Phase 2, ADR-0014).
// Phase 4 Sprint 2 adds LinkedAccount (docs/DATABASE.md Section 6.5,
// status vocabulary corrected per ADR-0018) and SecretRecord (the interim
// envelope-encrypted secrets store, ADR-0016 - not part of DATABASE.md's
// documented schema, since it's a Sprint 2 implementation detail, not a
// product-domain entity).
// Phase 9 adds IdentityGraph's confidence-score column and merge-
// suggestion/audit tables (IdentityMergeSuggestion/IdentityMergeLog/
// IdentitySplitLog), plus Conversation's priorityScore/isArchived/
// category/lastReadAt (Smart Inbox). Still deferred: RLS, DB role
// separation (DATABASE.md Section 21), Tag/MessageTag (Section 6.11) -
// all tracked in docs/reviews/.
// Phase 10 adds Rule/RuleExecutionLog/ScheduledJob (AUTOMATION_ENGINE.md,
// DATABASE.md Section 6.12/6.13) and Conversation.tags - a plain string[]
// column standing in for the still-deferred relational Tag/MessageTag
// model (Section 6.11), scoped exactly to what the `tag.apply` automation
// action needs; see docs/reviews/phase-10-review.md.
// Phase 11 adds NotificationPreference exactly per DATABASE.md Section
// 6.14 (silent hours, VIP override, keyword alerts) - see
// docs/reviews/phase-11-review.md for what Phase 11 did and didn't build.
// Phase 13 adds Workspace.aiEnabled, AiCreditLedger, MessageAiSummary
// (DATABASE.md Section 6.15, ADR-0021's provider-agnostic AI layer) - see
// docs/reviews/phase-13-review.md.
// IDs are UUIDv7 (ADR-0007), generated application-side (see
// packages/database/src/ids.ts) rather than via Prisma's @default(uuid()),
// which only generates UUIDv4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The billing/identity root - one per customer (docs/DATABASE.md Section 6.1).
/// Added Phase 2: every registration creates one automatically, per
/// docs/API.md Section 10.1 ("even solo signups get one automatically").
model Organization {
  id        String    @id @db.Uuid
  name      String
  slug      String    @unique
  planTier  String    @default("free") @map("plan_tier")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // soft delete - docs/DATABASE.md Section 7

  workspaces Workspace[]
  aiCreditLedger AiCreditLedger[]

  @@map("organizations")
}

model Workspace {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  timezone       String    @default("UTC")
  /// Phase 13 (docs/adr/0021-provider-agnostic-ai-abstraction.md) - gates
  /// every AI capability (ADR-0021 Decision 5). Referenced by API.md's
  /// "requires the workspace to have AI enabled" language but never
  /// previously modeled - this is that field. Defaults `true` with a
  /// starter credit grant at registration (the same "working demo by
  /// default, explicitly disable-able" precedent Phase 10's starter rule
  /// set), so graceful degradation (turning it off) is actually testable.
  aiEnabled      Boolean   @default(true) @map("ai_enabled")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at") // soft delete - docs/DATABASE.md Section 7, enforced via packages/database/src/soft-delete.ts

  organization  Organization      @relation(fields: [organizationId], references: [id])
  members       WorkspaceMember[]
  contacts      Contact[]
  conversations Conversation[]
  messages      Message[]
  notifications Notification[]
  linkedAccounts LinkedAccount[]
  identityMergeSuggestions IdentityMergeSuggestion[]
  identityMergeLogs        IdentityMergeLog[]
  identitySplitLogs        IdentitySplitLog[]
  rules                    Rule[]
  notificationPreferences  NotificationPreference[]
  messageAiSummaries       MessageAiSummary[]
  pushSubscriptions        PushSubscription[]

  @@map("workspaces")
}

/// Global identity, independent of any workspace (docs/DATABASE.md Section 6.3).
/// Auth secrets live in UserCredentials, not here - see that model's comment.
model User {
  id          String    @id @db.Uuid
  email       String    @unique // lower-cased at the application layer for case-insensitivity - see AuthService; docs/DATABASE.md's citext suggestion is deliberately simplified here, recorded in docs/reviews/phase-2-review.md
  displayName String?   @map("display_name")
  avatarUrl   String?   @map("avatar_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at") // soft delete - docs/DATABASE.md Section 7

  credentials UserCredentials?
  memberships WorkspaceMember[]
  sessions    Session[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]

  @@map("users")
}

/// Auth secrets, deliberately separate from `users` (docs/DATABASE.md
/// Section 6.3's stated reasoning: reduces the blast radius of an
/// accidental over-fetch on the frequently-joined User row).
/// `passwordHash` is nullable specifically so a future passkey-only or
/// OAuth-only user (ROADMAP.md Phase 2's remaining checklist items) never
/// requires a password row - this is the concrete schema property that
/// makes Passkeys additive later, not a redesign.
model UserCredentials {
  id           String   @id @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  passwordHash String?  @map("password_hash")
  totpSecret   String?  @map("totp_secret") // reserved for 2FA (ROADMAP.md Phase 2 checklist, not implemented yet)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_credentials")
}

/// Which Users belong to which Workspace, with what role (docs/DATABASE.md
/// Section 6.3) - the RBAC foundation (Owner/Admin/Member, ARCHITECTURE.md
/// Section 6 step 4).
model WorkspaceMember {
  id              String    @id @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  role            String    @default("owner") // "owner" | "admin" | "member" - docs/DATABASE.md Section 6.3
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  joinedAt        DateTime  @default(now()) @map("joined_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at") // soft delete - docs/DATABASE.md Section 7

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId], name: "uq_workspace_members_workspace_user")
  @@map("workspace_members")
}

/// Refresh-token session state (docs/DATABASE.md Section 6.20). `familyId`
/// implements the rotation + reuse-detection scheme (ARCHITECTURE.md
/// Section 6, SECURITY.md Section 4.3): presenting an already-rotated
/// token from a family revokes every session in it.
model Session {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  familyId         String    @map("family_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address") @db.Inet
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId], name: "idx_sessions_user_id")
  @@index([familyId], name: "idx_sessions_family_id")
  @@map("sessions")
}

/// Append-only audit trail (docs/DATABASE.md Section 6.21). No `updatedAt`/
/// `deletedAt` - application code only ever creates rows here (see
/// AuditLogService), never updates or deletes them. Postgres-role-level
/// enforcement (REVOKE UPDATE, DELETE) is deferred - DATABASE.md Section 21,
/// tracked as an already-deferred gap since the Phase 1 review.
/// No FK relations to Workspace/User: DATABASE.md's cascading rules keep
/// audit history independent of whether its subject still exists.
model AuditLog {
  id             String   @id @db.Uuid
  workspaceId    String?  @map("workspace_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorType      String   @map("actor_type") // "user" | "system" | "rule" | "api_key"
  action         String
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id") @db.Uuid
  metadata       Json?
  ipAddress      String?  @map("ip_address") @db.Inet
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt], name: "idx_audit_logs_workspace_id_created_at")
  @@index([actorUserId, createdAt], name: "idx_audit_logs_actor_user_id_created_at")
  @@index([resourceType, resourceId], name: "idx_audit_logs_resource_type_resource_id")
  @@map("audit_logs")
}

model Provider {
  id          String @id @db.Uuid
  key         String @unique
  displayName String @map("display_name")

  contactIdentities ContactIdentity[]
  conversations     Conversation[]
  linkedAccounts    LinkedAccount[]

  @@map("providers")
}

/// A Workspace's connection to one Provider account, e.g. "this Telegram
/// bot" (docs/DATABASE.md Section 6.5). `status` uses CONNECTOR_SDK.md
/// Section 2's full 9-state lifecycle vocabulary, not DATABASE.md's
/// original 5-value sketch - see ADR-0018 for why. `credentialsRef` is an
/// opaque pointer into SecretRecord (ADR-0016's interim secrets store) -
/// this model never holds a raw credential itself.
model LinkedAccount {
  id                String    @id @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  providerId        String    @map("provider_id") @db.Uuid
  externalAccountId String    @map("external_account_id")
  displayLabel      String?   @map("display_label")
  status            String    @default("registered") // CONNECTOR_SDK.md Section 2 lifecycle states - ADR-0018
  credentialsRef    String    @map("credentials_ref") @db.Uuid // -> SecretRecord.id, never a raw credential - SECURITY.md Section 5, ADR-0016
  webhookSecret     String?   @map("webhook_secret") // inbound webhook verification only - not a provider credential, SECURITY.md Section 5's boundary doesn't apply to this value (see TelegramController)
  syncCursor        String?   @map("sync_cursor") // durable checkpoint (CONNECTOR_SDK.md Section 9) - Telegram's getUpdates offset
  lastSyncedAt      DateTime? @map("last_synced_at")
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at") // soft delete - docs/DATABASE.md Section 7

  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  provider      Provider       @relation(fields: [providerId], references: [id])
  conversations Conversation[]

  @@unique([workspaceId, providerId, externalAccountId], name: "uq_linked_accounts_workspace_provider_external")
  @@index([workspaceId], name: "idx_linked_accounts_workspace_id")
  @@index([status], name: "idx_linked_accounts_status")
  @@map("linked_accounts")
}

/// The interim secrets store (ADR-0016) - AES-256-GCM ciphertext, never
/// soft-deleted (deliberately excluded from packages/database/src/soft-delete.ts's
/// SOFT_DELETE_MODELS): SECURITY.md Section 5.2 requires disconnecting a
/// LinkedAccount to unconditionally, irreversibly delete its credential,
/// which a soft-deleted-but-still-decryptable row would not achieve.
model SecretRecord {
  id         String   @id @db.Uuid
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes    @map("auth_tag")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("secret_records")
}

/// A deduplicated real person, independent of channel - IdentityGraph's
/// persistence layer (docs/ARCHITECTURE.md Section 13, docs/DATABASE.md
/// Section 6.6). Phase 3 implemented exact-match resolution only; Phase 9
/// adds confidence-scored fuzzy candidate matching, a persisted
/// merge-suggestion review queue, and manual merge/split (see
/// packages/identity/src/matching.ts).
model Contact {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  displayName String    @map("display_name")
  isVip       Boolean   @default(false) @map("is_vip")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at") // soft delete - docs/DATABASE.md Section 7

  workspace  Workspace         @relation(fields: [workspaceId], references: [id])
  identities ContactIdentity[]
  messages   Message[]

  @@map("contacts")
}

model ContactIdentity {
  id              String   @id @db.Uuid
  contactId       String   @map("contact_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  providerId      String   @map("provider_id") @db.Uuid
  externalId      String   @map("external_id")
  handle          String?
  matchType       String   @default("exact") @map("match_type") // "exact" | "confirmed_manual" - docs/DATABASE.md Section 6.6
  /// Null for "exact" matches (certainty, not a probability) - populated
  /// only for links that originated as a fuzzy suggestion before being
  /// human-confirmed (docs/DATABASE.md Section 6.6, ARCHITECTURE.md
  /// Section 13.6). Retained after confirmation for audit/tuning, not
  /// cleared once approved.
  confidenceScore Decimal? @map("confidence_score") @db.Decimal(3, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  contact  Contact  @relation(fields: [contactId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  @@unique([providerId, externalId, workspaceId], name: "uq_contact_identities_provider_external")
  @@map("contact_identities")
}

/// A persisted, reviewable candidate identity match (docs/DATABASE.md
/// Section 6.6, ADR-0013) - never a fired-and-forgotten event. Every
/// candidate match short of an exact (provider, externalId) repeat
/// becomes one of these, regardless of confidence score, and sits
/// `pending` until a human explicitly approves or rejects it
/// (ARCHITECTURE.md Section 13.6 - a hard product boundary, not a
/// tunable threshold).
model IdentityMergeSuggestion {
  id                  String    @id @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  candidateContactIdA String    @map("candidate_contact_id_a") @db.Uuid
  candidateContactIdB String    @map("candidate_contact_id_b") @db.Uuid
  confidenceScore     Decimal   @map("confidence_score") @db.Decimal(3, 2)
  /// The human-legible evidence shown on the review card (UI_GUIDE.md
  /// Section 7) - never raw signal weights (ARCHITECTURE.md Section 13.8).
  matchingSignals     Json      @map("matching_signals")
  status              String    @default("pending") // "pending" | "approved" | "rejected" | "expired"
  reviewedByUserId    String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt          DateTime? @map("reviewed_at")
  /// Unreviewed suggestions expire rather than accumulate forever - both
  /// an anti-fatigue measure and because stale evidence may no longer
  /// reflect current reality (ARCHITECTURE.md Section 13.6).
  expiresAt           DateTime  @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, status], name: "idx_identity_merge_suggestions_workspace_status")
  @@index([expiresAt], name: "idx_identity_merge_suggestions_expires_at")
  @@map("identity_merge_suggestions")
}

/// Append-only (docs/DATABASE.md Section 6.6) - what actually happened,
/// permanently, distinct from the suggestion record above ("what was
/// proposed and reviewed"). No updatedAt/deletedAt by design.
model IdentityMergeLog {
  id                     String    @id @db.Uuid
  workspaceId            String    @map("workspace_id") @db.Uuid
  primaryContactId       String    @map("primary_contact_id") @db.Uuid
  mergedContactId        String    @map("merged_contact_id") @db.Uuid
  mergedByUserId         String    @map("merged_by_user_id") @db.Uuid
  confidenceScoreAtMerge Decimal?  @map("confidence_score_at_merge") @db.Decimal(3, 2)
  matchingSignals        Json      @map("matching_signals")
  createdAt              DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt], name: "idx_identity_merge_log_workspace_id_created_at")
  @@map("identity_merge_log")
}

/// Append-only - records that a split happened and how identities were
/// redistributed (docs/DATABASE.md Section 6.6).
model IdentitySplitLog {
  id                  String   @id @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  originalContactId   String   @map("original_contact_id") @db.Uuid
  resultingContactIds Json     @map("resulting_contact_ids")
  splitByUserId       String   @map("split_by_user_id") @db.Uuid
  reason              String?
  createdAt           DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt], name: "idx_identity_split_log_workspace_id_created_at")
  @@map("identity_split_log")
}

model Conversation {
  id              String   @id @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  providerId      String   @map("provider_id") @db.Uuid
  linkedAccountId String?  @map("linked_account_id") @db.Uuid // nullable - Mock Connector conversations (Phase 1-3) have none; real connectors (Phase 4 Sprint 2+) always set it
  externalId      String   @map("external_id")
  title           String?
  lastMessageAt DateTime?  @map("last_message_at")
  /// Rule-based cross-app importance signal (docs/PRODUCT.md "Unified
  /// priority scoring"), reflecting the highest-scored message in this
  /// conversation - VIP sender and urgency-keyword matches, computed at
  /// ingestion time (Phase 9), never AI-derived (AI refinement is
  /// Phase 13, optional, additive on top of this base signal).
  priorityScore Int        @default(0) @map("priority_score")
  isArchived    Boolean    @default(false) @map("is_archived")
  /// Free-form, user-set (Phase 9) - no auto-categorization yet.
  category      String?
  /// Applied by the `tag.apply` automation action (Phase 10,
  /// AUTOMATION_ENGINE.md Section 5.1) - a plain string array, not the
  /// relational Tag/MessageTag model DATABASE.md Section 6.11 documents
  /// (still deferred). Disclosed simplification: no per-workspace tag
  /// catalog, no tag colors/metadata, just the names automations write.
  tags          String[]   @default([])
  /// Null means never read - every message in the conversation is unread.
  /// Compared against lastMessageAt to compute the unread state the
  /// "Needs You" count (docs/PRODUCT.md UI Principles) is built from.
  lastReadAt    DateTime?  @map("last_read_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  deletedAt     DateTime?  @map("deleted_at") // soft delete - docs/DATABASE.md Section 7

  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  provider      Provider       @relation(fields: [providerId], references: [id])
  linkedAccount LinkedAccount? @relation(fields: [linkedAccountId], references: [id])
  messages      Message[]

  @@unique([providerId, externalId, workspaceId], name: "uq_conversations_provider_external")
  @@map("conversations")
}

model Message {
  id               String   @id @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  conversationId   String   @map("conversation_id") @db.Uuid
  externalId       String   @map("external_id")
  senderContactId  String?  @map("sender_contact_id") @db.Uuid
  direction        String    // "inbound" | "outbound" - docs/DATABASE.md Section 6.8
  bodyText         String    @map("body_text")
  receivedAt       DateTime  @map("received_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at") // soft delete - docs/DATABASE.md Section 7

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  conversation Conversation  @relation(fields: [conversationId], references: [id])
  sender       Contact?      @relation(fields: [senderContactId], references: [id])
  notifications Notification[]

  @@unique([conversationId, externalId], name: "uq_messages_conversation_external")
  @@map("messages")
}

model Notification {
  id          String   @id @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  messageId   String?  @map("message_id") @db.Uuid
  type        String   @default("message") // "message" | "reminder" | "digest" | "system" - docs/DATABASE.md Section 6.14
  title       String
  body        String
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  message   Message?  @relation(fields: [messageId], references: [id])

  @@map("notifications")
}

/// Per-(workspace, user) delivery preferences (docs/DATABASE.md Section
/// 6.14, docs/API.md's `PATCH /v1/notification-preferences`) - silent
/// hours, VIP override, and keyword alerts. Self-only by design (API.md:
/// "a notification preference is never settable on someone else's behalf,
/// even by a workspace admin"). Consulted by the Automation Engine's
/// Context Object (Phase 10's `workspace.isSilentHours` stub, now real -
/// see docs/reviews/phase-11-review.md) using the workspace owner's row as
/// the workspace-wide setting, a disclosed simplification until per-member
/// notification targeting exists.
model NotificationPreference {
  id                 String    @id @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  silentHoursStart   String?   @map("silent_hours_start") // "HH:mm", workspace-timezone-local (DATABASE.md Section 6.14's `time` column, stored as text - no migrations mechanism for a native `time` type via `db push`)
  silentHoursEnd     String?   @map("silent_hours_end")
  vipOverrideEnabled Boolean   @default(true) @map("vip_override_enabled")
  keywordAlerts      String[]  @default([]) @map("keyword_alerts")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId], name: "uq_notification_preferences_workspace_user")
  @@map("notification_preferences")
}

/// The Automation Engine's rule definition (docs/AUTOMATION_ENGINE.md,
/// docs/DATABASE.md Section 6.12). `trigger`/`conditions`/`actions` are
/// jsonb, validated at the application layer against
/// packages/automation-engine's types - not enforced by Postgres, matching
/// every other jsonb column in this schema. `version` is the optimistic-
/// locking column (DATABASE.md Section 9): every save increments it via an
/// explicit `updateMany({ where: { id, version } })`, never relied on
/// implicitly. Disclosed simplification vs. AUTOMATION_ENGINE.md Section
/// 14.1: no separate draft/published version history table yet - an
/// edit updates this row in place (still safe, since `version` still
/// prevents two concurrent edits from silently clobbering each other) -
/// see docs/reviews/phase-10-review.md.
model Rule {
  id             String    @id @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  name           String
  isEnabled      Boolean   @default(true) @map("is_enabled")
  priority       Int       @default(0)
  /// Denormalized copy of `trigger.type` (jsonb below), indexed - what
  /// AUTOMATION_ENGINE.md Section 10 means by "matching is indexed, not a
  /// full scan": a workspace's rules for an incoming trigger type are
  /// found via this column, not a jsonb scan of every rule.
  triggerType    String    @map("trigger_type")
  trigger        Json
  conditions     Json
  actions        Json
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at") // soft delete - docs/DATABASE.md Section 7

  workspace      Workspace          @relation(fields: [workspaceId], references: [id])
  executionLogs  RuleExecutionLog[]
  scheduledJobs  ScheduledJob[]

  @@index([workspaceId, triggerType, isEnabled], name: "idx_rules_workspace_id_trigger_type_is_enabled")
  @@map("rules")
}

/// Append-only execution trace (docs/AUTOMATION_ENGINE.md Section 5.4/10,
/// docs/DATABASE.md Section 6.12 item 29). Idempotency (Section 10) is
/// enforced by `@@unique([ruleId, ruleVersion, triggerEventId])` - a
/// retried event can never cause the same rule version to log a second
/// execution for the same underlying trigger.
model RuleExecutionLog {
  id             String   @id @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  ruleId         String   @map("rule_id") @db.Uuid
  ruleVersion    Int      @map("rule_version")
  triggerEventId String   @map("trigger_event_id")
  messageId      String?  @map("message_id") @db.Uuid
  matchedAt      DateTime @map("matched_at")
  /// Per-action results (docs/AUTOMATION_ENGINE.md Section 5.4): partial
  /// success is representable, never collapsed to one boolean.
  actionsExecuted Json    @map("actions_executed")
  status         String   // "success" | "partial_failure" | "failure" - AUTOMATION_ENGINE.md Section 5.4
  errorDetail    String?  @map("error_detail")
  createdAt      DateTime @default(now()) @map("created_at")

  rule Rule @relation(fields: [ruleId], references: [id])

  @@unique([ruleId, ruleVersion, triggerEventId], name: "uq_rule_execution_logs_rule_version_trigger_event")
  @@index([ruleId, matchedAt], name: "idx_rule_execution_logs_rule_id_matched_at")
  @@index([workspaceId, matchedAt], name: "idx_rule_execution_logs_workspace_id_matched_at")
  @@map("rule_execution_logs")
}

/// Durable record of a relative-time trigger's pending fire, per
/// docs/AUTOMATION_ENGINE.md Section 3.3 - the BullMQ delayed job is the
/// execution mechanism, this row is the source of truth a crash or Redis
/// eviction can't silently lose. Scoped to `time.no_reply_after`
/// (Phase 10's only relative-time trigger type) - recurring/cron
/// schedules (AUTOMATION_ENGINE.md Section 3.1's "Scheduled triggers")
/// and a reconciliation sweep for missed fires are disclosed as deferred
/// to Phase 11, per DATABASE.md Section 6.13's own note that the sweep is
/// a Phase 11 concern.
model ScheduledJob {
  id             String    @id @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  ruleId         String    @map("rule_id") @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  scheduledFor   DateTime  @map("scheduled_for")
  status         String    @default("pending") // "pending" | "completed" | "cancelled" - DATABASE.md Section 6.13
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  rule Rule @relation(fields: [ruleId], references: [id])

  @@unique([ruleId, conversationId], name: "uq_scheduled_jobs_rule_conversation")
  @@index([status, scheduledFor], name: "idx_scheduled_jobs_status_scheduled_for")
  @@map("scheduled_jobs")
}

/// Append-only AI credit ledger (docs/DATABASE.md Section 6.15, ADR-0021) -
/// billing-adjacent balances must be reconstructable/auditable, never a
/// single mutable counter. `balanceAfter` is a denormalized running total
/// for fast reads; the full ledger can always be summed to verify it.
model AiCreditLedger {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  entryType       String   @map("entry_type") // "grant" | "consumption" | "purchase" | "expiry" - DATABASE.md Section 6.15
  amount          Int // positive for grant/purchase, negative for consumption
  balanceAfter    Int      @map("balance_after")
  feature         String? // which AI feature consumed credits, e.g. "summarize", "classify"
  relatedMessageId String? @map("related_message_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt], name: "idx_ai_credit_ledger_organization_id_created_at")
  @@map("ai_credit_ledger")
}

/// A generated AI summary (docs/DATABASE.md Section 6.15, ADR-0021) - a
/// separate table, never a column on Message, so AI output is trivially
/// strippable (disabling AI for a workspace never touches Message rows).
/// Exactly one of messageId/conversationId should be non-null (Section
/// 6.15's CHECK constraint) - enforced at the application layer, not the
/// database, since this project has no migrations mechanism beyond
/// `prisma db push` to add a raw CHECK constraint safely (the same
/// disclosed simplification `docs/reviews/phase-9-review.md`'s dedup
/// check and `docs/reviews/phase-12-review.md`'s search vector already
/// used for the identical reason).
model MessageAiSummary {
  id             String   @id @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  messageId      String?  @map("message_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  summaryText    String   @map("summary_text")
  modelUsed      String   @map("model_used")
  generatedAt    DateTime @map("generated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt], name: "idx_message_ai_summaries_workspace_id_created_at")
  @@map("message_ai_summaries")
}

/// A browser's Web Push subscription (docs/ROADMAP.md Phase 14) - one row
/// per (user, device/browser). `endpoint` is unique per the Push API spec
/// (the browser's push service issues a distinct URL per subscription);
/// `p256dh`/`auth` are the subscription's own encryption keys, required to
/// encrypt a push payload to it, never a credential of ours.
model PushSubscription {
  id          String   @id @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  endpoint    String   @unique
  p256dh      String
  auth        String
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([workspaceId], name: "idx_push_subscriptions_workspace_id")
  @@map("push_subscriptions")
}
